#!/bin/bash
# Run a command as a step of one of your running allocations, with all of its CPUs, memory and GPUs.
# Euler's srun defaults give a step 1 CPU and 1 GB; a session inside a job would also hand the step its own job's
# SLURM_* and OMP_NUM_THREADS.
set -euo pipefail

usage="usage: euler-step <job name or id> <command> [args...]"
case ${1:-} in -h | --help)
	echo "$usage"
	exit 0
	;;
esac
if [ $# -lt 2 ]; then
	echo "$usage" >&2
	exit 2
fi
job=$1
shift

# The step runs on the allocation's node, where this node's $TMPDIR doesn't exist: srun would start it in /tmp
if [ -n "${TMPDIR:-}" ]; then
	for a in "$PWD" "$@"; do
		if [[ $a == *"$TMPDIR"* ]]; then
			echo "euler-step: $a is in this node's local \$TMPDIR; a step needs shared storage" >&2
			exit 1
		fi
	done
fi

if [[ $job =~ ^[0-9]+$ ]]; then sel=(-j "$job"); else sel=(--name="$job"); fi
rows=$(squeue --me -h "${sel[@]}" -o '%i|%T|%C|%N|%L|%r' 2>/dev/null || true)
n=$(grep -c . <<<"$rows" || true)
if [ "$n" -ne 1 ]; then
	echo "euler-step: $n of your jobs match $job" >&2
	exit 1
fi
IFS='|' read -r id state cpus node left reason <<<"$rows"
if [ "$state" != RUNNING ]; then
	echo "euler-step: job $id is $state ($reason)" >&2
	exit 1
fi
echo "euler-step: job $id on $node, $cpus CPUs, $left left" >&2

mapfile -t outer < <(compgen -v SLURM_)
unset OMP_NUM_THREADS "${outer[@]}"
# Euler's cli_filter sets -c 1 before srun reads -c, so srun warns that the step may never run; it runs
exec srun --jobid="$id" --overlap -n1 -c"$cpus" --mem-per-cpu=0 "$@" \
	2> >(grep -v --line-buffered "cpus-per-task value exceeds that of job" >&2)
